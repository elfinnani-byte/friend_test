# 이 파일을 .env 로 복사해 값을 채운다. .env 는 저장소와 배포에 올라가지 않는다.
# LLM_PROVIDER: openai, gemini, claude, fake 중 하나. fake 는 키 없이 가짜 응답을 돌려준다.
LLM_PROVIDER=fake
LLM_API_KEY=
# 비워 두면 제공자별 기본 모델을 쓴다
LLM_MODEL=
ENV=local

# 저장소와 로그인. 처음에는 memory, none 으로 둔다. Supabase 연결은 docs/supabase.md
STORAGE=memory
AUTH=none
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GOOGLE_LOGIN=false

# Langfuse 계측. 두 키가 모두 있어야 켜진다. 보내기 전에 전화번호, 이메일, 카드 번호는 가린다(app/tracing.py)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# 퀴즈 대결 앱의 문제 풀기 API(/api/quiz/solve). true 일 때만 열린다. LLM 키는 위 LLM_API_KEY 를 그대로 쓴다
QUIZ_SOLVER_ENABLED=false
# 이미지를 읽을 수 있는 모델. 비우면 LLM_MODEL(또는 제공자 기본 모델)과 같다
QUIZ_MODEL=
# IP 하나가 1분에 보낼 수 있는 요청 수
QUIZ_RATE_PER_MINUTE=10
# 그림 없는 글 문제 모델. 비우면 QUIZ_MODEL 을 쓴다(예: claude-haiku-5-5)
QUIZ_MODEL_TEXT=
# 이지모드 서버 직접 풀기(/api/quiz/auto/*). true 일 때만 열린다. 진행 상태는 인스턴스 메모리에 있다
QUIZ_AUTO_ENABLED=false
# 퀴즈 서버에 답을 바로 제출할지. false 면 quiz_server, token, question_id 가 와도 답만 돌려준다(앱이 직접 제출)
QUIZ_SERVER_SUBMIT=true
# 사진이 다 보이는지(VISIBLE) 판단해 다시 찍기를 알릴지. on(기본): Langfuse version quiz-v2-visible, off: 고치기 전처럼 끝까지 풀기(quiz-v1)
QUIZ_VISIBLE_CHECK=on
