# 이 파일을 .env 로 복사해 값을 채운다. .env 는 저장소와 배포에 올라가지 않는다.
# LLM_PROVIDER: openai, gemini, claude, fake 중 하나. fake 는 키 없이 가짜 응답을 돌려준다.
LLM_PROVIDER=fake
LLM_API_KEY=
# 비워 두면 제공자별 기본 모델을 쓴다
LLM_MODEL=
ENV=local

# 저장소와 로그인. 처음에는 memory, none 으로 둔다. Supabase 연결은 docs/supabase.md
STORAGE=memory
AUTH=none
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GOOGLE_LOGIN=false

# Langfuse 계측. 두 키가 모두 있어야 켜진다. 보내기 전에 전화번호, 이메일, 카드 번호는 가린다(app/tracing.py)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# 토스페이먼츠 결제위젯 v2(주문서형) 연동 키. 개발자센터 API 키 메뉴의 '주문서형, 결제창형 연동 키'를 쓴다.
# 두 키가 모두 있고 테스트 키(test_)일 때만 크레딧 구매가 켜진다. 시크릿 키는 서버에서만 쓴다(app/payments.py)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
